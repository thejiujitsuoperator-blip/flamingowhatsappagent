# PostgreSQL / Supabase connection string.
# Supabase: Project Settings > Database > Connection string (URI), and set DATABASE_SSL=true.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_agent
DATABASE_SSL=false

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gym knowledge base + automation settings (copy config/gym.example.json)
GYM_CONFIG_PATH=config/gym.json

# Folder where the WhatsApp session is stored after scanning the QR code. Keep it private.
WA_AUTH_DIR=auth_state

# Comma separated phone numbers (with country code) of the owner/staff allowed to run admin commands.
ADMIN_PHONES=919876543210

# Country code prepended to 10-digit local numbers typed by admins.
DEFAULT_COUNTRY_CODE=91

# Set to false to disable reminders/follow-ups (the chat agent keeps working).
SCHEDULER_ENABLED=true

LOG_LEVEL=info
