# Same database as the WhatsApp agent (its migrations must have been run).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_agent
DATABASE_SSL=false

# Gemini, used to decide which chats are gym enquiries and to qualify leads (not needed with --no-llm).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# The agent's gym config (plan codes, timezone).
GYM_CONFIG_PATH=../config/gym.json

# Owner/staff numbers: their chats are never imported as leads.
ADMIN_PHONES=919876543210
DEFAULT_COUNTRY_CODE=91
LOG_LEVEL=info
