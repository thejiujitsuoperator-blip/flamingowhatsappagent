{
  "name": "whatsapp-history-importer",
  "version": "0.1.0",
  "description": "One-time WhatsApp chat history importer: saves and qualifies gym leads, never sends messages",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "whatsapp-history-import": "dist/cli.js"
  },
  "scripts": {
    "import": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
